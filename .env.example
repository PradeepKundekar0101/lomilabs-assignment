# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=lomi
POSTGRES_PASSWORD=lomi
POSTGRES_DB=lomi

# Host ports. Change them if something local already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=8080

# App config when running api/worker on the host (pnpm dev/start).
# Inside docker compose these are set per service to the container hostnames instead.
DATABASE_URL=postgres://lomi:lomi@localhost:5432/lomi
REDIS_URL=redis://localhost:6379
PORT=3000

# Object storage (MinIO in docker compose). The bucket is created by the minio-init service.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lomi-documents
S3_ACCESS_KEY=lomi
S3_SECRET_KEY=lomisecret

# Extraction worker. Get a key at console.anthropic.com; without one, extractions fail visibly.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
WORKER_CONCURRENCY=2
# Only for running the worker on the host; the worker image sets its own path.
EXPECTED_FIELDS_PATH=fixtures/expected-fields.json
